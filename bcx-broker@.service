[Unit]
# One instance per tenant; %i is the tenant name and the only thing that
# varies. Its env file carries owner, installation, project and socket.
Description=bartixcloud CI runner broker for tenant %i
After=network-online.target incus.service
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/bartixcloud/app.env
# GENERATED by bcx-gen-tenant-env from tenants.yml (install.sh).
EnvironmentFile=/etc/bcx-broker/%i.env
# /run/bcx-broker is shared by every tenant broker and read by the dispatcher;
# Preserve keeps one tenant's stop from deleting the others' sockets.
RuntimeDirectory=bcx-broker
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
# Runs as root: it reads the App private key and drives the local incus socket.
# The binary is root-owned and replaced atomically by install.sh, never in place.
ExecStart=/opt/bcx-broker/bcx-broker
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
